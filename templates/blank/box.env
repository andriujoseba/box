# The blank template — a box with nobody home, not a box with the safety off.
# Same image, same isolation, same entry path as every other template; the
# only thing missing is the tooling. Start here to build a new template.
# New templates inherit the VM trust boundary and should keep it unless they
# state why automatic container fallback is acceptable
# (BOX_NO_CONTAINER_FALLBACK, #175). A server-class seed whose guest runs
# docker declares the stronger BOX_REQUIRE_VM instead (#68).
BOX_DESCRIPTION="Bare Debian 13 — same isolation, no tooling"
BOX_IMAGE="images:debian/13/cloud"
BOX_USER="dev"
BOX_CPU="2"
BOX_MEMORY="2GiB"
BOX_DISK="20GiB"
BOX_NO_CONTAINER_FALLBACK="1"
